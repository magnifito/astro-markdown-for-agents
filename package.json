{
  "name": "astro-markdown-for-agents",
  "version": "0.1.0",
  "description": "Astro integration that serves Markdown to AI agents — Cloudflare free plan compatible",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "GPL-3.0",
  "keywords": [
    "astro",
    "astro-integration",
    "markdown",
    "ai",
    "agents",
    "cloudflare",
    "llm",
    "llms-txt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/magnifito/astro-markdown-for-agents"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "astro": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
