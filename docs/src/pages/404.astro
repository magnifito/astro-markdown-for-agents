---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Page not found | Markdown for Agents for Astro" description="Requested page was not found.">
	<main id="main-content" class="not-found">
		<p class="eyebrow">404</p>
		<h1>Page not found.</h1>
		<p>Route moved, or link is incomplete.</p>
		<a class="button button-primary" href={base}>Return home</a>
	</main>
</Layout>

<style>
	.not-found {
		width: min(calc(100% - 2rem), 760px);
		margin: 0 auto;
		padding-top: 8rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(3rem, 10vw, 6rem);
		letter-spacing: -0.06em;
	}

	.not-found > p:not(.eyebrow) {
		margin-bottom: 2rem;
		color: var(--muted);
	}
</style>
