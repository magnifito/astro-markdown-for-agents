	}

	.guide-card p {
		margin: 0.6rem 0 1.4rem;
		color: var(--muted);
	}

	.guide-card b {
		color: var(--amber);
		font-size: 0.82rem;
	}

	.pilot-card {
		padding: clamp(2rem, 6vw, 4.5rem);
		text-align: center;
	}

	.pilot-card h2 {
		margin: 0;
		font-size: clamp(2.3rem, 6vw, 4.5rem);
		line-height: 1;
		letter-spacing: -0.055em;
	}

	.pilot-card > p:not(.eyebrow) {
		max-width: 650px;
		margin: 1.3rem auto 2rem;
		color: var(--muted);
		font-size: 1.06rem;
	}

	.pilot-card > div {
		display: flex;
		justify-content: center;
		gap: 0.7rem;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			padding-top: 5rem;
		}

		.terminal {
			width: 100%;
			max-width: 650px;
		}

		.proof-strip {
			grid-template-columns: repeat(2, 1fr);
		}

		.proof-strip li:nth-child(2) {
			border-right: 0;
		}

		.proof-strip li:nth-child(-n + 2) {
			border-bottom: 1px solid var(--line);
		}

