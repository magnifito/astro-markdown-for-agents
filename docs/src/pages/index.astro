	@media (max-width: 680px) {
		.mode-grid,
		.demo-grid,
		.guide-grid {
			grid-template-columns: 1fr;
		}

		.hero h1 {
			font-size: clamp(3rem, 17vw, 5rem);
		}

		.proof-strip li {
			padding: 1.2rem;
		}

		.demo-actions,
		.pilot-card > div {
			align-items: stretch;
			flex-direction: column;
		}

		.text-link {
			padding: 0.7rem;
			text-align: center;
		}
	}
</style>
