		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
		align-items: center;
		gap: clamp(3rem, 8vw, 8rem);
		min-height: 670px;
		padding-top: 3rem;
	}

	.hero h1 {
		max-width: 760px;
		margin: 0;
		font-size: clamp(3.4rem, 7.5vw, 6.7rem);
		line-height: 0.94;
		letter-spacing: -0.07em;
	}

	.hero h1 span {
		color: var(--green);
	}

	.hero-lede {
		max-width: 670px;
		margin: 1.8rem 0 0;
		color: #b9cbc3;
		font-size: clamp(1.08rem, 2vw, 1.28rem);
		line-height: 1.65;
	}

	.hero-lede code {
		color: var(--amber);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 2rem;
	}

	.hero-note {
		margin: 1.2rem 0 0;
		color: var(--faint);
		font-size: 0.88rem;
	}

	.terminal {
		overflow: hidden;
		background: #050b09;
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.35);
	}

	.terminal-top {
		display: flex;
		align-items: center;
		gap: 0.38rem;
		height: 44px;
		padding: 0 0.9rem;
		border-bottom: 1px solid var(--line);
		background: #0c1815;
	}

	.terminal-top > span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #345149;
	}

	.terminal-top > span:first-child {
		background: #ff806c;
	}

	.terminal-top > span:nth-child(2) {
		background: #ffcb7a;
	}

	.terminal-top p {
		margin: 0 0 0 auto;
		color: var(--faint);
		font-family: "SFMono-Regular", Consolas, monospace;
