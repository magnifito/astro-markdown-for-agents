---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// Let's import the plugin version from package.json without failing if it can't find it dynamically
let version = '0.3.0';
try {
	const packageJson = JSON.parse(readFileSync(resolve('../package.json'), 'utf-8'));
	version = packageJson.version;
} catch (e) {
	// fallback to default
}
---

<Layout title="Astro Markdown for Agents | Premium Astro Integration">
	<main class="container">
		<header class="hero">
			<div class="hero-badge">v{version} Available Now</div>
			<h1 class="hero-title">Optimize Astro for <span class="gradient-text">AI Agents</span></h1>
			<p class="hero-subtitle">
				Serve token-efficient, perfectly formatted Markdown directly from your Astro site to AI crawlers like ChatGPT, Perplexity, and Claude. Save up to 80% on LLM tokens with zero configuration.
			</p>
			<div class="hero-actions">
				<a href="#installation" class="btn btn-primary">Get Started</a>
				<a href="https://github.com/magnifito/astro-markdown-for-agents" target="_blank" class="btn btn-secondary">View on GitHub</a>
			</div>
		</header>

		<section id="features" class="features-grid">
			<div class="feature-card">
				<div class="feature-icon">🚀</div>
				<h3>Zero Config</h3>
				<p>Automatically intercepts agent requests and responds with clean, semantic Markdown.</p>
			</div>
			<div class="feature-card">
				<div class="feature-icon">💰</div>
				<h3>Save Tokens</h3>
				<p>Reduce HTML bloat by up to 80%, accelerating agent processing and reducing API costs.</p>
			</div>
			<div class="feature-card">
				<div class="feature-icon">📜</div>
				<h3>Standard llms.txt</h3>
				<p>Automatically generates a standard <code>/llms.txt</code> map of your documentation for AI.</p>
			</div>
		</section>

		<section id="installation" class="code-section">
			<h2>Quick Installation</h2>
			<div class="terminal">
				<div class="terminal-header">
					<span class="dot red"></span>
					<span class="dot yellow"></span>
					<span class="dot green"></span>
				</div>
				<pre><code>npx astro add @puralex/astro-markdown-for-agents</code></pre>
			</div>
		</section>

		<section id="demo" class="demo-section">
			<h2>See It In Action</h2>
			<p>If you're reading this site via an AI agent, you're actually reading the Markdown output generated by this plugin!</p>
			<div class="demo-card">
				<p>Try curling this website as an agent:</p>
				<div class="terminal">
					<pre><code>curl -H "Accept: text/markdown" https://magnifito.github.io/astro-markdown-for-agents/</code></pre>
				</div>
			</div>
			<div class="demo-card">
				<p>Or check out the automatically generated LLMs index:</p>
				<a href="/astro-markdown-for-agents/llms.txt" class="btn btn-outline" target="_blank">View /llms.txt</a>
				<a href="/astro-markdown-for-agents/about" class="btn btn-outline" style="margin-left: 1rem">View About Page</a>
			</div>
		</section>
	</main>

	<footer>
		<p>&copy; {new Date().getFullYear()} Magnifito. Open source under MIT License.</p>
	</footer>
</Layout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 6rem;
	}

	.hero {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		margin-top: 4rem;
	}

	.hero-badge {
		background: rgba(102, 252, 241, 0.1);
		color: var(--primary-color);
		padding: 0.5rem 1rem;
		border-radius: 2rem;
		font-size: 0.875rem;
		font-weight: 600;
		border: 1px solid rgba(102, 252, 241, 0.2);
		backdrop-filter: blur(10px);
	}

	.hero-title {
		font-size: 4.5rem;
		line-height: 1.1;
		max-width: 800px;
	}

	.gradient-text {
		background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.25rem;
		color: var(--text-color);
		max-width: 600px;
		line-height: 1.6;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	.btn {
		padding: 0.875rem 2rem;
		border-radius: 0.5rem;
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.btn-primary {
		background-color: var(--primary-color);
		color: var(--bg-color);
		box-shadow: 0 0 20px rgba(102, 252, 241, 0.3);
	}

	.btn-primary:hover {
		background-color: #ffffff;
		box-shadow: 0 0 30px rgba(102, 252, 241, 0.5);
		transform: translateY(-2px);
	}

	.btn-secondary {
		background-color: var(--card-bg);
		color: #ffffff;
		border: 1px solid var(--card-border);
		backdrop-filter: blur(10px);
	}

	.btn-secondary:hover {
		border-color: var(--primary-color);
		transform: translateY(-2px);
	}

	.btn-outline {
		display: inline-block;
		background-color: transparent;
		color: var(--primary-color);
		border: 1px solid var(--primary-color);
		margin-top: 1rem;
	}

	.btn-outline:hover {
		background-color: rgba(102, 252, 241, 0.1);
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.feature-card {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 1rem;
		padding: 2rem;
		backdrop-filter: blur(10px);
		transition: transform 0.3s ease, border-color 0.3s ease;
	}

	.feature-card:hover {
		transform: translateY(-5px);
		border-color: var(--primary-color);
	}

	.feature-icon {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
	}

	.feature-card h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	.feature-card p {
		line-height: 1.6;
		opacity: 0.9;
	}

	.code-section, .demo-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 2rem;
	}

	.demo-section p {
		font-size: 1.1rem;
		max-width: 600px;
	}

	.demo-card {
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 1rem;
		padding: 2rem;
		width: 100%;
		max-width: 700px;
	}

	.terminal {
		background: #000000;
		border-radius: 0.5rem;
		width: 100%;
		max-width: 600px;
		overflow: hidden;
		text-align: left;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.terminal-header {
		background: #1a1b20;
		padding: 0.75rem 1rem;
		display: flex;
		gap: 0.5rem;
	}

	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}

	.dot.red { background: #ff5f56; }
	.dot.yellow { background: #ffbd2e; }
	.dot.green { background: #27c93f; }

	.terminal pre {
		padding: 1.5rem;
		margin: 0;
		overflow-x: auto;
	}

	.terminal code {
		font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
		color: #e6e6e6;
		font-size: 0.9rem;
	}

	footer {
		text-align: center;
		padding: 2rem;
		color: var(--text-color);
		opacity: 0.6;
		border-top: 1px solid var(--card-border);
		margin-top: auto;
	}

	@media (max-width: 768px) {
		.hero-title {
			font-size: 3rem;
		}
		.hero-actions {
			flex-direction: column;
			width: 100%;
		}
		.btn {
			width: 100%;
			text-align: center;
		}
	}
</style>
