		line-height: 1.8;
	}

	.terminal pre span,
	.terminal pre b {
		color: var(--green);
		font-weight: 600;
	}

	.terminal-status {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.8rem 1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.78rem;
	}

	.terminal-status code {
		margin-left: auto;
		color: var(--amber);
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--green-strong);
		box-shadow: 0 0 12px var(--green-strong);
	}

	.proof-strip {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		width: min(calc(100% - 2rem), var(--max));
		margin: 0 auto;
		padding: 0;
		border-block: 1px solid var(--line);
		list-style: none;
	}

	.proof-strip li {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 1.7rem;
		border-right: 1px solid var(--line);
	}

	.proof-strip li:last-child {
		border-right: 0;
	}

	.proof-strip strong {
		color: var(--green);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 1.5rem;
	}

	.proof-strip span {
		color: var(--muted);
		font-size: 0.82rem;
	}

	.mode-grid,
	.demo-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.mode-card {
		padding: clamp(1.5rem, 4vw, 2.4rem);
	}

	.mode-number {
		margin: 0 0 2rem;
		color: var(--green);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.mode-card h3 {
		margin: 0;
		font-size: 1.5rem;
		letter-spacing: -0.03em;
	}

	.mode-card > p:not(.mode-number) {
		min-height: 78px;
		color: var(--muted);
	}

	.mode-card > p code,
	.mode-card li code {
		color: var(--amber);
	}

	.mode-card pre {
		overflow-x: auto;
		min-height: 110px;
		margin: 1.6rem 0;
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--code);
		color: #d4e4dd;
		font-size: 0.8rem;
		line-height: 1.65;
	}

	.mode-card ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mode-card li {
		padding: 0.4rem 0;
		border-bottom: 1px solid rgba(29, 55, 48, 0.65);
		color: #b7c8c0;
		font-size: 0.9rem;
	}

	.mode-card li::before {
		margin-right: 0.55rem;
		color: var(--green);
		content: "✓";
	}

	.code-panel {
		overflow: hidden;
		background: var(--code);
	}

	.code-panel.output {
		border-color: rgba(140, 242, 176, 0.38);
	}

	.panel-label {
		display: flex;
		justify-content: space-between;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 700;
	}

	.panel-label code {
		color: var(--amber);
		font-weight: 400;
	}

	.code-panel pre {
		overflow: auto;
		height: 320px;
		margin: 0;
		padding: 1.2rem;
		color: #c9d9d2;
		font-size: 0.76rem;
		line-height: 1.65;
		white-space: pre-wrap;
	}

	.demo-actions {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		margin-top: 1.2rem;
	}

	.text-link {
		color: var(--green);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.install-card {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: end;
		gap: 3rem;
		padding: clamp(1.5rem, 5vw, 3.5rem);
		border-color: rgba(140, 242, 176, 0.28);
		background:
			linear-gradient(120deg, rgba(140, 242, 176, 0.08), transparent 50%),
			var(--surface);
	}

	.install-card h2 {
		max-width: 590px;
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.2rem);
		line-height: 1.05;
		letter-spacing: -0.045em;
	}

	.install-card p:last-child {
		color: var(--muted);
	}

	.install-command {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-width: 0;
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: 0.55rem;
		background: var(--code);
	}

	.install-command code {
		overflow-x: auto;
		min-width: 0;
		color: var(--green);
		font-size: 0.78rem;
		white-space: nowrap;
	}

	.install-command a {
		margin-left: auto;
		color: var(--amber);
		font-size: 0.78rem;
		font-weight: 700;
		text-decoration: none;
	}

	.comparison {
		overflow-x: auto;
	}

	.comparison table {
		width: 100%;
		border-collapse: collapse;
	}

	.comparison th,
	.comparison td {
		padding: 1rem 1.2rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
	}

	.comparison th {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.comparison td {
		color: #b8c9c1;
		font-size: 0.9rem;
	}

	.comparison td:nth-child(2) {
		color: var(--green);
	}

	.comparison code {
		color: var(--amber);
	}

	.comparison tr:last-child td {
		border-bottom: 0;
	}

	.comparison-note {
		color: var(--faint);
		font-size: 0.8rem;
	}

	.guide-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.guide-card {
		display: block;
		padding: 1.7rem;
		text-decoration: none;
		transition:
			transform 160ms ease,
