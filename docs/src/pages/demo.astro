---
import Layout from '../layouts/Layout.astro';
import { htmlToMarkdown } from '@puralex/astro-markdown-for-agents/html-to-markdown';

const base = import.meta.env.BASE_URL;
const href = (path = '') => `${base}${path}`.replace(/\/{2,}/g, '/');

const examples = [
	{
		name: 'Documentation',
		html: `<header><nav><a href="/">Home</a><a href="/docs">Docs</a></nav></header>
<main>
  <article>
    <h1>Authentication</h1>
    <p>Send your token with every API request.</p>
    <h2>Example</h2>
    <pre><code>Authorization: Bearer $TOKEN</code></pre>
    <blockquote>Never commit tokens to source control.</blockquote>
  </article>
</main>
<footer>Terms · Privacy · Copyright 2026</footer>`,
	},
	{
		name: 'Product page',
		html: `<main>
  <h1>Edge Database</h1>
  <p>Low-latency reads from every region.</p>
  <h2>Features</h2>
  <ul>
    <li>Automatic replication</li>
    <li>Point-in-time recovery</li>
    <li>Usage-based pricing</li>
  </ul>
  <p><a href="/start">Create a database</a></p>
</main>`,
	},
];

const converted = examples.map((example) => {
	const markdown = htmlToMarkdown(example.html);
	const htmlBytes = new TextEncoder().encode(example.html).length;
	const markdownBytes = new TextEncoder().encode(markdown).length;
	return {
		...example,
		markdown,
		htmlBytes,
		markdownBytes,
		reduction: Math.round((1 - markdownBytes / htmlBytes) * 100),
	};
});
---

<Layout
	title="Live HTML-to-Markdown Demo | Markdown for Agents for Astro"
	description="Inspect real HTML-to-Markdown output generated by the Astro Markdown for Agents converter."
>
	<main id="main-content" class="demo-page">
		<header>
			<p class="eyebrow">Converter proof</p>
			<h1>HTML in.<br /><span>Agent-ready Markdown out.</span></h1>
			<p>
				Examples below run through the package converter during this site build.
				No hand-edited output.
			</p>
		</header>

		{converted.map((example) => (
			<section class="example">
				<div class="example-heading">
					<div>
						<p class="eyebrow">{example.name}</p>
						<h2>{example.reduction}% smaller payload</h2>
					</div>
					<p>{example.htmlBytes} bytes → {example.markdownBytes} bytes</p>
				</div>
				<div class="example-grid">
					<div class="card">
						<strong>HTML</strong>
						<pre><code>{example.html}</code></pre>
					</div>
					<div class="card output">
						<strong>Markdown</strong>
						<pre><code>{example.markdown}</code></pre>
					</div>
				</div>
			</section>
		))}

		<section class="delivery card">
			<div>
				<p class="eyebrow">Verify delivery</p>
				<h2>Static demo, explicit Markdown URL.</h2>
				<p>
					GitHub Pages is static hosting, so it cannot negotiate on
					<code>Accept</code>. This build exposes generated Markdown directly.
					Runtime adapters can negotiate at the original URL.
				</p>
			</div>
			<div class="delivery-actions">
				<a class="button button-primary" href={href('demo/index.md')}>Open demo Markdown</a>
				<a class="button button-secondary" href={href('guides/astro-markdown-for-agents/')}>
					Configure runtime mode
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.demo-page {
		width: min(calc(100% - 2rem), var(--max));
		margin: 0 auto;
		padding-top: 6rem;
	}

	header {
		max-width: 850px;
	}

	header h1 {
		margin: 0;
		font-size: clamp(3.3rem, 8vw, 6.4rem);
		line-height: 0.96;
		letter-spacing: -0.065em;
	}

	header h1 span {
		color: var(--green);
	}

	header > p:last-child {
		max-width: 670px;
		color: var(--muted);
		font-size: 1.12rem;
	}

	.example {
		padding-top: 7rem;
	}

	.example-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 1.4rem;
	}

	.example-heading h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
		letter-spacing: -0.04em;
	}

	.example-heading > p {
		color: var(--amber);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 0.82rem;
	}

	.example-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.example-grid > div {
		overflow: hidden;
		background: var(--code);
	}

	.example-grid .output {
		border-color: rgba(140, 242, 176, 0.45);
	}

	.example-grid strong {
		display: block;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
		color: var(--muted);
		font-size: 0.75rem;
		text-transform: uppercase;
	}

	.example-grid pre {
		overflow: auto;
		min-height: 330px;
		margin: 0;
		padding: 1.2rem;
		color: #c7d8d0;
		font-size: 0.78rem;
		line-height: 1.7;
		white-space: pre-wrap;
	}

	.delivery {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 3rem;
		margin-top: 7rem;
		padding: clamp(1.5rem, 5vw, 3.5rem);
	}

	.delivery h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.1rem);
		line-height: 1.06;
		letter-spacing: -0.045em;
	}

	.delivery p:last-child {
		max-width: 650px;
		color: var(--muted);
	}

	.delivery code {
		color: var(--amber);
	}

	.delivery-actions {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	@media (max-width: 780px) {
		.example-grid,
		.delivery {
			grid-template-columns: 1fr;
		}

		.example-heading {
			align-items: start;
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
